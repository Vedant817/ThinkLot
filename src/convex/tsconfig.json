{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowJs": true,
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": [
		"./**/*.ts",
		"./_generated/**/*.ts",
		"../lib/convex/validation.ts"
	],
	"exclude": ["../node_modules"]
}