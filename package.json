{
  "name": "thinklot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "verify:e2e": "pwsh -NoProfile -File scripts/verify-e2e.ps1",
    "verify:shortcuts": "vite-node scripts/verify-shortcuts.ts",
    "verify:scoring": "vite-node scripts/verify-scoring.ts",
    "verify:capture": "vite-node scripts/verify-capture-regressions.ts",
    "verify:list": "vite-node scripts/verify-list-filters.ts",
    "verify:lotquery": "vite-node scripts/verify-lot-query.ts",
    "verify:maturity": "vite-node scripts/verify-maturity.ts",
    "verify:clustering": "vite-node scripts/verify-clustering.ts",
    "verify:roadmap": "vite-node scripts/verify-roadmap.ts",
    "verify:offline-banner": "vite-node scripts/verify-offline-banner.ts",
    "verify:device-fixes": "vite-node scripts/verify-device-fixes.ts",
    "verify:ai": "vite-node scripts/verify-ai.ts",
    "verify:pm-import": "vite-node scripts/verify-pm-import.ts",
    "verify:export": "vite-node scripts/verify-export.ts",
    "verify:export-targets": "vite-node scripts/verify-export-targets.ts",
    "verify:theme": "vite-node scripts/verify-theme-contrast.ts",
    "verify:jira-fixture": "vite-node scripts/verify-jira-fixture.ts",
    "verify:portability": "vite-node scripts/verify-portability.ts",
    "verify:review": "vite-node scripts/verify-review.ts",
    "verify:parity": "vite-node scripts/verify-mobile-parity.ts",
    "verify:web": "vite-node scripts/verify-web.ts",
    "verify:authproxy": "vite-node scripts/verify-authproxy.ts",
    "verify:concurrency": "vite-node scripts/verify-concurrency.ts",
    "verify:contracts": "node apps/ios/scripts/verify-contracts.mjs",
    "verify:offline": "npm run verify:scoring && npm run verify:capture && npm run verify:list && npm run verify:lotquery && npm run verify:maturity && npm run verify:clustering && npm run verify:roadmap && npm run verify:offline-banner && npm run verify:device-fixes && npm run verify:ai && npm run verify:pm-import && npm run verify:export && npm run verify:export-targets && npm run verify:theme && npm run verify:jira-fixture && npm run verify:portability && npm run verify:review && npm run verify:shortcuts && npm run verify:contracts"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.2",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.6.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vite-node": "^6.0.0"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "convex": "^1.46.0",
    "jose": "^6.2.12"
  }
}
