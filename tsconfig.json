{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		// SvelteKit/Vite own the build. Emitting .js next to the sources here
		// duplicates the Convex bundler's output and breaks `convex codegen`.
		"noEmit": true
	},
	"exclude": ["src/convex"]
}
